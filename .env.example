# ──────────────────────────────────────────────────────────────
# CylinGuard environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ──────────────────────────────────────────────────────────────

# --- MySQL (used by the mysql container) ---
MYSQL_DATABASE=cylinguard
MYSQL_USER=cylinguard_user
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_password

# --- Database connection (backend) ---
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_URL=mysql+pymysql://cylinguard_user:change_me@mysql:3306/cylinguard

# For running WITHOUT Docker against a native MySQL on localhost:3306, use:
# DATABASE_URL=mysql+pymysql://cylinguard_user:change_me@127.0.0.1:3306/cylinguard

# --- Security ---
JWT_SECRET=change_this_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- API ---
API_PORT=8000
CORS_ORIGINS=http://localhost,http://localhost:5173

# --- Device / IoT ---
# Optional shared secret the ESP32 sends as X-Device-Key. Leave blank to disable.
DEVICE_API_KEY=
# Seconds without a packet before a device is marked OFFLINE
DEVICE_OFFLINE_SECONDS=120

# --- Sensor processing ---
# Weight deltas smaller than this (kg) are treated as load-cell noise, not consumption
MIN_MEANINGFUL_DELTA_KG=0.02
# A positive weight jump at or above this (kg) is classified as a refill
REFILL_DELTA_KG=2.0
# Number of recent readings used by the rolling-median smoother
SMOOTHING_WINDOW=5

# --- Demo mode ---
DEMO_MODE_DEFAULT=true
DEMO_TICK_SECONDS=5

# --- Frontend (Vite build-time) ---
VITE_API_URL=/api
VITE_WS_URL=/ws
